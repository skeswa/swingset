Environment="PATH=/nix/store/nja3jimv61blss0mfgjqa68rfiwfxv39-coreutils-9.8/bin:/nix/store/f72alkaiwzx07151akyzlz0w7lwpi6px-findutils-4.10.0/bin:/nix/store/fpidzzfdfq4kqpg7izrjwl5dprm1ybql-gnugrep-3.12/bin:/nix/store/m4mnwm47q796m3zq16bpbca19r7ab2hk-gnused-4.9/bin:/nix/store/f99j50qvfy3lr4mxxad1qxsf7c6c9brj-systemd-258.7/bin:/nix/store/nja3jimv61blss0mfgjqa68rfiwfxv39-coreutils-9.8/sbin:/nix/store/f72alkaiwzx07151akyzlz0w7lwpi6px-findutils-4.10.0/sbin:/nix/store/fpidzzfdfq4kqpg7izrjwl5dprm1ybql-gnugrep-3.12/sbin:/nix/store/m4mnwm47q796m3zq16bpbca19r7ab2hk-gnused-4.9/sbin:/nix/store/f99j50qvfy3lr4mxxad1qxsf7c6c9brj-systemd-258.7/sbin"
Environment="TMPDIR=/var/tmp"
Environment="TZDIR=/nix/store/61dk4kx1ra82nlzymqdxb8alpc0nn452-tzdata-2026b/share/zoneinfo"
Environment="UV_CACHE_DIR=/var/lib/swingset/uv-cache"
Environment="UV_HTTP_TIMEOUT=120"
Environment="UV_PROJECT_ENVIRONMENT=/var/lib/swingset/venv"
Environment="UV_PYTHON=/nix/store/s5rij9y3vb4gxbh0iqz3k0ndmsac7h02-python3-3.12.13/bin/python3.12"
