DynamicUser=false
EnvironmentFile=/etc/swingset.env
ExecStart=/nix/store/9kz3y5annjxcdfpmgqwinsc58027wjlr-swingset/bin/swingset backup --state /var/lib/swingset --config /nix/store/c0dpchrf4b6hkxlc2yn4jm1v96ld0xd2-source/config --overrides /Users/skeswa/repos/skeswa/swingset/overrides
