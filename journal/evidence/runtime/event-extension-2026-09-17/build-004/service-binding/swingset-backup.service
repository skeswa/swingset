Group=swingset
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/swingset
Restart=on-failure
RestartSec=60
TimeoutStartSec=infinity
TimeoutStopSec=45
Type=oneshot
UMask=0077
User=swingset
WorkingDirectory=/nix/store/c0dpchrf4b6hkxlc2yn4jm1v96ld0xd2-source
