        "d=/var/lib/postgresql/data\nu=$(id -u); g=$(id -g)\ntest \"$u\" -gt 0\ntest -d \"$d\" && test ! -L \"$d\"\ns=$(stat -c '%u %g %a %h %f %s %d %i' -- \"$d\")\nset -- $s\ntest \"$#\" -eq 8 && test \"$1\" = \"$u\"\ntest ! -e \"$d/postmaster.pid\" && test ! -L \"$d/postmaster.pid\"\ntest -d \"$d/pg_wal\" && test ! -L \"$d/pg_wal\"\ntest -d \"$d/pg_tblspc\" && test ! -L \"$d/pg_tblspc\"\ntablespaces=$(find \"$d/pg_tblspc\" -mindepth 1 -maxdepth 1 -print -quit)\ntest -z \"$tablespaces\"\ncontrol=$(pg_controldata \"$d\")\nsys=$(printf '%s\\n' \"$control\" | awk -F ': *' '$1==\"Database system identifier\" {print $2}')\nstate=$(printf '%s\\n' \"$control\" | awk -F ': *' '$1==\"Database cluster state\" {print $2}')\ntest \"$sys\" = 7708959291098337318 && test \"$state\" = 'shut down'\nprintf '{\"resolved_uid\":%s,\"resolved_gid\":%s,\"pgdata\":{\"uid\":%s,\"gid\":%s,\"mode\":\"%s\",\"nlink\":%s,\"kind\":\"%s\",\"bytes\":%s,\"device\":%s,\"inode\":%s},\"owner_uid_equals_resolved_postgres\":true,\"postmaster_pid_absent\":true,\"wal_is_directory_not_symlink\":true,\"tablespaces_empty_directory_not_symlink\":true,\"system_identifier\":\"%s\",\"cluster_clean_shutdown\":true}\\n' \"$u\" \"$g\" \"$1\" \"$2\" \"$3\" \"$4\" \"$5\" \"$6\" \"$7\" \"$8\" \"$sys\"\n"
