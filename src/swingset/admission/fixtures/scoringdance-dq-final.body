#dks-consent{position:fixed;left:0;right:0;bottom:0;z-index:2147483000;background:#1b1b1b;color:#f2f2f2;
  box-shadow:0 -0.5rem 1.5rem rgba(0,0,0,.4);font-size:.9rem;line-height:1.4;padding:1rem 1rem calc(1rem + env(safe-area-inset-bottom))}
#dks-consent[hidden]{display:none}
