<script>
  /* Einzige Definition: Seiten duerfen _webpushrScriptReady() nicht selbst definieren (diese hier
     ueberschrieb sie). Seiten legen Attribute in window.sdWebpushrAttrs ab und hoeren auf das
     Event "sd:webpushr" (Abo aktiv) bzw. "sd:webpushr-permission" (Antwort auf die Browser-Abfrage). */
  function _webpushrScriptReady(){
    try { if (window.sdWebpushrAttrs && Object.keys(window.sdWebpushrAttrs).length) webpushr('attributes', window.sdWebpushrAttrs); } catch (e) {}
    /* SDK ruft diese Funktion nur bei bestehendem/neuem Abo auf */
    try { window.dispatchEvent(new CustomEvent("sd:webpushr")); } catch (e) {}
    webpushr('fetch_id',function (sid) { 
        //save id to database
        console.log('webpushr subscriber id: ' + sid)
        $("#webpushr_sid").html("WebPushr-SID: "+sid);
        $("#webpushr-prompt-wrapper").css("display","none");
        $(document).trigger("webpushr_sid", sid);
    });
  }
  function webpushrPermissionAction(action){
    try { window.dispatchEvent(new CustomEvent("sd:webpushr-permission", {detail: {action: action}})); } catch (e) {}
  }
</script>
