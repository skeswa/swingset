<div id="app" v-cloak>
  <div class="container-fluid">
    <div class="row">
      <!-- Left Skyscraper Ad (Desktop only) -->
      <div class="col-xl-2 d-none d-xl-block d-none">
        <div class="ad-skyscraper" style=" display: none !important;">
          <div>📢 Advertisement Space 160x600</div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-xl-8">
        <div class="container">
          <!-- Top Banner Ad -->
          <div class="ad-banner-top d-none" style="display: none !important;">
            <div>
              <i class="fas fa-ad fa-2x mb-2"></i>
              <div><strong>Advertisement Space</strong></div>
              <div class="small">728x90 Leaderboard</div>
            </div>
          </div>

          <!-- Filter Section -->
          <div class="filter-section">
            <!-- Upcoming / Past switch -->
            <div class="timeframe-tabs">
  <a href="/enUS/" class="timeframe-tab active">
    <i class="far fa-calendar-alt"></i> Upcoming Events  </a>
  <a href="/enUS/recent" class="timeframe-tab">
    <i class="far fa-history"></i> Past Events  </a>
</div>
            <div class="filter-pills" style="display: none;">
              <button 
                class="filter-pill" 
                :class="{ active: activeFilter === 'all' }"
                @click="setFilter('all')"
              >
                All Dances              </button>
              <button 
                class="filter-pill" 
                :class="{ active: activeFilter === '1' }"
                @click="setFilter('1')"
              >
                West Coast Swing
              </button>
              <button 
                class="filter-pill" 
                :class="{ active: activeFilter === '4' }"
                @click="setFilter('4')"
              >
                Bachata
              </button>
              <button 
                class="filter-pill" 
                :class="{ active: activeFilter === '3' }"
                @click="setFilter('3')"
              >
                Zouk
              </button>
              <button 
                class="filter-pill" 
                :class="{ active: activeFilter === '5' }"
                @click="setFilter('5')"
              >
                Country
              </button>
            </div>
            
            <div class="search-box">
              <i class="fas fa-search"></i>
              <input 
                type="text" 
                v-model="searchQuery" 
                placeholder="Search events by name or city..."
              >
            </div>
          </div>

          <!-- Events Grid -->
          <div class="events-grid">
            <div 
              v-for="event in filteredEvents" 
              :key="event.id"
              class="event-card"
              :class="{ 
                'cancelled': event.is_cancelled, 
                'cancelled-corona': event.is_cancelled_corona 
              }"
            >
              <!-- Corona Icon -->
              <img 
                v-if="event.is_cancelled_corona" 
                src="/skins/grey/images/icon/coronav_icon_50x50.png" 
                class="corona-icon"
                alt="Corona cancelled"
              >
              
              <!-- Event Image -->
              <div class="event-card-image">
                <picture v-if="event.img_header_md5">
                  <source 
                    :data-srcset="`/images/header/${event.img_header_md5}.webp?width=350`" 
                    type="image/webp"
                  >
                  <img 
                    :src="`/images/header/${event.img_header_md5}.jpg?width=350`" 
                    class="lazyload"
                    :alt="event.name"
                  >
                </picture>
                
                <!-- Event Badge -->
                <div v-if="event.badge" class="event-badge" :class="event.badge.type">
                  {{ event.badge.text }}
                </div>
              </div>

              <!-- Card Header -->
              <div class="event-card-header">
                <h2 class="event-card-title" :title="event.name">{{ event.name }}</h2>
              </div>

              <!-- Card Body -->
              <div class="event-card-body">
                <!-- Date -->
                <div class="event-info-item">
                  <i class="far fa-calendar-alt"></i>
                  <span v-html="event.date_formatted"></span>
                </div>

                <!-- Location -->
                <div v-if="event.city_name" class="event-info-item">
                  <i class="far fa-map-marker-alt"></i>
                  <img 
                    v-if="event.country_flag" 
                    :src="event.country_flag" 
                    :alt="event.country_name"
                    :title="event.country_name"
                  >
                  <span>{{ event.city_name }} ({{ event.country_name }})</span>
                </div>

                <!-- CO2 Neutral -->
                <div v-if="event.is_co2_neutral" class="event-info-item co2-badge">
                  <i class="fa-duotone fa-leaf"></i>
                  <span>CO² neutral</span>
                </div>
              </div>

              <!-- Card Footer with Buttons -->
              <div class="event-card-footer">
                <!-- Registration Button -->
                <a 
                  v-if="event.btn_register" 
                  :href="event.btn_register.url" 
                  class="event-btn event-btn-primary"
                  :target="event.btn_register.external ? '_blank' : ''"
                  :rel="event.btn_register.external ? 'nofollow' : ''"
                >
                  <img 
                    v-if="event.btn_register.icon" 
                    :src="event.btn_register.icon" 
                    style="height: 1rem;"
                  >
                  <span v-html="event.btn_register.text"></span>
                </a>

                <!-- Wall/Lists Button -->
                <a 
                  v-if="event.btn_wall" 
                  :href="event.btn_wall.url" 
                  class="event-btn event-btn-warning"
                >
                  <span v-html="event.btn_wall.text"></span
                </a>

                <!-- Mock Judging Button -->
                <a 
                  v-if="event.btn_mock" 
                  :href="event.btn_mock.url" 
                  class="event-btn event-btn-secondary"
                >
                  <i class="fa-solid fa-graduation-cap"></i>
                  <span v-html="event.btn_mock.text"></span
                </a>

                <!-- Results Button -->
                <a 
                  v-if="event.btn_results" 
                  :href="event.btn_results.url" 
                  class="event-btn event-btn-success"
                >
                  <span v-html="event.btn_results.text"></span>
                </a>

                <!-- Tickets Button -->
                <a 
                  v-if="event.btn_tickets" 
                  :href="event.btn_tickets.url" 
                  class="event-btn event-btn-secondary"
                  target="_blank"
                  rel="nofollow"
                >
                  <i class="far fa-ticket-alt"></i>
                  <span v-html="event.btn_tickets.text"></span>
                </a>

                <!-- Facebook Button -->
                <a 
                  v-if="event.btn_facebook" 
                  :href="event.btn_facebook.url" 
                  class="event-btn event-btn-secondary"
                  target="_blank"
                  rel="nofollow"
                  style="background: #3b5998; color: white; border: none;"
                >
                  <i class="fa-brands fa-facebook"></i>
                </a>

                <!-- News Button -->
                <a 
                  v-if="event.btn_news" 
                  :href="event.btn_news.url" 
                  class="event-btn event-btn-news"
                >
                  <i class="fal fa-newspaper"></i>
                  {{ event.btn_news.text }}
                </a>
              </div>
            </div>
          </div>

          <!-- Empty State -->
          <div v-if="filteredEvents.length === 0" class="empty-state">
            <div class="empty-state-icon">
              <i class="fas fa-search"></i>
            </div>
            <h3 class="empty-state-title">No events found</h3>
            <p class="empty-state-text">Try adjusting your filters or search query</p>
          </div>

          <!-- Link to Recent Events -->
          <div class="text-center mb-5">
            <a href="/enUS/recent" class="event-btn event-btn-secondary" style="display: inline-flex;">
              <i class="far fa-history"></i>
              View Past Events            </a>
          </div>
        </div>
      </div>

      <!-- Right Skyscraper Ad (Desktop only) -->
      <div class="col-xl-2 d-none d-xl-block d-none" style=" display: none !important;">
        <div class="ad-skyscraper">
          <div>📢 Advertisement Space 160x600</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Vue 3 CDN -->
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="/skins/grey/js/lazysizes.min.js" async=""></script>

<script>
const { createApp } = Vue;

createApp({
  data() {
    return {
      events: [],
      activeFilter: 'all',
      searchQuery: '',
      weekdayNames: ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      translations: {
        register: "register",
        results: "Results",
        lists: "Lists",
        tickets: "Tickets",
        news: "News",
        mockjudging: "mockjudging",
        live_now: "LIVE NOW",
        starts_in_day: "starts in %d day",
        registration_open: "REGISTRATION OPEN"      }
    }
  },
  
  computed: {
    filteredEvents() {
      let filtered = this.events;
      
      // Filter by dance type
      if (this.activeFilter !== 'all') {
        filtered = filtered.filter(event => {
          if (this.activeFilter === '1') return event.is_wsdc;
          if (this.activeFilter === '3') return event.is_bzdc;
          if (this.activeFilter === '4') return event.is_bachatacouncil;
          if (this.activeFilter === '5') return event.is_country;
          return true;
        });
      }
      
      // Filter by search query
      if (this.searchQuery.trim()) {
        const query = this.searchQuery.toLowerCase();
        filtered = filtered.filter(event => 
          event.name.toLowerCase().includes(query) || 
          (event.city_name && event.city_name.toLowerCase().includes(query)) ||
          (event.country_name && event.country_name.toLowerCase().includes(query))
        );
      }
      
      return filtered;
    }
  },
  
  methods: {
    setFilter(filter) {
      this.activeFilter = filter;
      // Update URL without reload
      const url = new URL(window.location);
      if (filter === 'all') {
        url.searchParams.delete('type');
      } else {
        url.searchParams.set('type', filter);
      }
      window.history.pushState({}, '', url);
    },
    
    formatDate(dateFrom, dateTo) {
      const from = new Date(dateFrom);
      const to = new Date(dateTo);
      
      // If same day
      if (dateFrom.substring(0, 10) === dateTo.substring(0, 10)) {
        return this.weekdayNames[from.getDay()] + ' ' + this.formatDateShort(from);
      }
      
      return this.formatDateShort(from) + ' - ' + this.formatDateShort(to);
    },
    
    formatDateShort(date) {
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const year = date.getFullYear();
      return `${day}.${month}.${year}`;
    },
    
    getEventBadge(event) {
      const now = new Date();
      const eventStart = new Date(event.dt_event_from);
      const eventEnd = new Date(event.dt_event_to);
      
      // Live now
      if (now >= eventStart && now <= eventEnd) {
        return { type: 'live', text: this.translations.live_now };
      }

      // Starting soon (within 7 days)
      const daysUntil = Math.ceil((eventStart - now) / (1000 * 60 * 60 * 24));
      if (daysUntil > 0 && daysUntil <= 7) {
        return { type: 'soon', text: this.translations.starts_in_day.replace('%d', daysUntil) };
      }

      // Registration open
      if (event.dt_preregister_bis && now < new Date(event.dt_preregister_bis)) {
        return { type: 'registration', text: this.translations.registration_open };
      }
      
      return null;
    },
    
    processEvents(rawEvents) {
      const lang = "enUS";
      
      return rawEvents.map(event => {
        const processed = { ...event };
        
        // Use server-side i18n formatted date (falls back to JS formatting if missing)
        processed.date_formatted = event.date_formatted || this.formatDate(event.dt_event_from, event.dt_event_to);
        
        // Get badge
        processed.badge = this.getEventBadge(event);
        
        // Check if cancelled
        processed.is_cancelled = ['cancelled', 'cancelled_corona'].includes(event.event_status);
        processed.is_cancelled_corona = event.event_status === 'cancelled_corona';
        
        // CO2 neutral for Germany/Austria
        processed.is_co2_neutral = ['DEU', 'AUT'].includes(event.country);
        
        // Process buttons
        const now = new Date();
        const eventEnd = new Date(event.dt_event_to);
        
        if (!processed.is_cancelled) {
          // Registration button
          if (event.danceapp_register_event_id) {
            processed.btn_register = {
              url: `https://danceapp.net/events/${event.danceapp_register_event_id}/register`,
              text: this.translations.register + ' &raquo;',
              external: true,
              icon: 'https://danceapp.net/favicon.png'
            };
          } else if (event.dt_preregister_bis && now < new Date(event.dt_preregister_bis)) {
            processed.btn_register = {
              url: `/${lang}/events/${event.id}/register`,
              text: this.translations.register + ' &raquo;',
              external: false
            };
          }
          
          // Wall/Lists button
          if (new Date(event.dt_event_from) <= now && eventEnd >= now) {
            processed.btn_wall = {
              url: `/${lang}/events/${event.id}/wall`,
              text: this.translations.lists + ' &raquo;'
            };
          }
          
          // Mock judging button
          if (event.is_mockjudge_shownfront == 1 && now < eventEnd) {
            processed.btn_mock = {
              url: `/${lang}/events/${event.id}/mock`,
              text: this.translations.mockjudging + ' &raquo;'
            };
          }
          
          // Tickets button
          if (event.url_ticket) {
            processed.btn_tickets = {
              url: event.url_ticket,
              text: this.translations.tickets + ' &raquo;'
            };
          }
          
          // Facebook button
          if (event.facebook_event_id) {
            processed.btn_facebook = {
              url: `https://www.facebook.com/events/${event.facebook_event_id}/`
            };
          }
        }
        
        // Results button (always show if published)
        if (event.dt_publish && now >= new Date(event.dt_publish)) {
          processed.btn_results = {
            url: `/${lang}/events/${event.id}/results/`,
            text: this.translations.results + ' &raquo;'
          };
        }
        
        // News button
        if (event.has_news == 1) {
          processed.btn_news = {
            url: `/${lang}/events/${event.id}/news/`,
            text: this.translations.news
          };
        }
        
        return processed;
      });
    }
  },
  
