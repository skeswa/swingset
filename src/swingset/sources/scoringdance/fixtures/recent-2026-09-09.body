<style>/* Modern CSS Variables */
:root {
  --primary: #00897B;
  --primary-dark: #004D40;
  --primary-light: #80CBC4;
  --accent: #ec4899;
  --accent-dark: #db2777;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  --text-primary: #1f2937;
  --text-secondary: #6b7280;
  --text-light: #9ca3af;
  --bg-primary: #ffffff;
  --bg-secondary: #f9fafb;
  --bg-tertiary: #f3f4f6;
  --border: #e5e7eb;
  --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  --gradient-primary: linear-gradient(135deg, #00897B 0%, #004D40 100%);
  --gradient-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  --gradient-accent: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

/* Typography - Using distinctive fonts */
@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap');

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  color: var(--text-primary);
  background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
  min-height: 100vh;
}

/* Hero Section with modern gradient */
.hero-section {
  background: linear-gradient(135deg, #aaa 0%, #888 100%);
  color: white;
  padding: 4rem 0 3rem;
  margin-bottom: 2rem;
  position: relative;
  overflow: hidden;
}

.hero-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-title {
  font-family: 'Sora', sans-serif;
  font-size: 3.5rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
  text-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  animation: fadeInUp 0.8s ease-out;
}

.hero-subtitle {
  font-size: 1.25rem;
  opacity: 0.9;
  animation: fadeInUp 0.8s ease-out 0.2s backwards;
}

/* Ad Placeholders */
.ad-banner-top {
  background: linear-gradient(135deg, #667eea20 0%, #764ba220 100%);
  border: 2px dashed var(--border);
  border-radius: 12px;
  padding: 2rem;
  text-align: center;
  margin-bottom: 2rem;
  min-height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Sora', sans-serif;
  color: var(--text-secondary);
  transition: all 0.3s ease;
}

.ad-banner-top:hover {
  border-color: var(--primary);
  background: linear-gradient(135deg, #667eea30 0%, #764ba230 100%);
}

.ad-skyscraper {
  background: linear-gradient(135deg, #f093fb20 0%, #f5576c20 100%);
  border: 2px dashed var(--border);
  border-radius: 12px;
  padding: 1rem;
  text-align: center;
  min-height: 600px;
  display: flex;
  align-items: center;
  justify-content: center;
  writing-mode: vertical-rl;
  font-family: 'Sora', sans-serif;
  color: var(--text-secondary);
  position: sticky;
  top: 2rem;
  transition: all 0.3s ease;
}

.ad-skyscraper:hover {
  border-color: var(--accent);
  background: linear-gradient(135deg, #f093fb30 0%, #f5576c30 100%);
}

/* Filter Section */
.filter-section {
  background: var(--bg-primary);
  padding: 1.5rem;
  border-radius: 16px;
  box-shadow: var(--shadow-md);
  margin-bottom: 2rem;
  animation: fadeInUp 0.8s ease-out 0.4s backwards;
}

.filter-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.filter-pill {
  padding: 0.5rem 1.25rem;
  border-radius: 50px;
  border: 2px solid var(--border);
  background: var(--bg-primary);
  color: var(--text-primary);
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 0.95rem;
  font-family: 'Sora', sans-serif;
}

.filter-pill:hover {
  border-color: var(--primary);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.filter-pill.active {
  background: var(--gradient-primary);
  color: white;
  border-color: transparent;
  box-shadow: var(--shadow-md);
}

/* Timeframe Tabs (upcoming / past events) */
.timeframe-tabs {
  display: flex;
  gap: 0.25rem;
  padding: 0.25rem;
  background: var(--bg-tertiary);
  border-radius: 12px;
}

.timeframe-tab {
  flex: 1 1 0;
  min-width: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.65rem 1rem;
  border-radius: 9px;
  font-family: 'Sora', sans-serif;
  font-weight: 600;
  font-size: 0.95rem;
  line-height: 1.2;
  text-align: center;
  color: var(--text-secondary);
  text-decoration: none;
  transition: all 0.25s ease;
}

.timeframe-tab:hover {
  color: var(--primary-dark);
  text-decoration: none;
}

.timeframe-tab.active,
.timeframe-tab.active:hover {
  background: var(--gradient-primary);
  color: #fff;
  box-shadow: var(--shadow-sm);
}

@media (max-width: 480px) {
  .timeframe-tab {
    font-size: 0.85rem;
    padding: 0.6rem 0.5rem;
  }
}

.search-box {
  position: relative;
  margin-top: 1rem;
}

.search-box input {
  width: 100%;
  padding: 0.875rem 1.25rem 0.875rem 3rem;
  border: 2px solid var(--border);
  border-radius: 12px;
  font-size: 1rem;
  transition: all 0.3s ease;
  background: var(--bg-primary);
}

.search-box input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
}

.search-box i {
  position: absolute;
  left: 1.25rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-secondary);
}

/* Event Grid */
.events-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1.5rem;
  margin-bottom: 3rem;
}

/* Event Card - Modern Design */
.event-card {
  background: var(--bg-primary);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  animation: fadeInUp 0.6s ease-out backwards;
}

.event-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-xl);
}

.event-card-image {
  position: relative;
  height: 180px;
  overflow: hidden;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.event-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.event-card:hover .event-card-image img {
  transform: scale(1.08);
}

.event-badge {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  padding: 0.375rem 0.875rem;
  border-radius: 50px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  backdrop-filter: blur(10px);
  font-family: 'Sora', sans-serif;
  z-index: 2;
  box-shadow: var(--shadow-md);
}

.event-badge.live {
  background: rgba(239, 68, 68, 0.9);
  color: white;
  animation: pulse 2s ease-in-out infinite;
}

.event-badge.soon {
  background: rgba(245, 158, 11, 0.9);
  color: white;
}

.event-badge.registration {
  background: rgba(16, 185, 129, 0.9);
  color: white;
}

.event-card-header {
  padding: 1.25rem;
  border-bottom: 1px solid var(--border);
}

.event-card-title {
  font-family: 'Sora', sans-serif;
  font-size: 1.25rem;
  font-weight: 700;
  margin: 0;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.event-card-body {
  padding: 1.25rem;
  flex-grow: 1;
}

.event-info-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
  color: var(--text-secondary);
  font-size: 0.95rem;
}

.event-info-item i {
  color: var(--primary);
  width: 20px;
  text-align: center;
}

.event-info-item img {
  width: 20px;
  height: auto;
  border-radius: 2px;
}

.event-card-footer {
  padding: 1rem 1.25rem;
  background: var(--bg-secondary);
  border-top: 1px solid var(--border);
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.event-btn {
  padding: 0.5rem 1rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.875rem;
  text-decoration: none;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  border: none;
  cursor: pointer;
  font-family: 'Sora', sans-serif;
}

.event-btn:hover { text-decoration: none;}

.event-btn span { text-decoration: none; }

.event-btn-primary {
  background: var(--gradient-primary);
  color: white;
  box-shadow: var(--shadow-sm);
}

.event-btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  color: white;
}

.event-btn-success {
  background: var(--success);
  color: white;
  box-shadow: var(--shadow-sm);
}

.event-btn-success:hover {
  background: #059669;
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  color: white;
}

.event-btn-secondary {
  background: var(--bg-primary);
  color: var(--text-primary);
  border: 2px solid var(--border);
}

.event-btn-secondary:hover {
  border-color: var(--primary);
  color: var(--primary);
  transform: translateY(-2px);
}

.event-btn-warning {
  background: var(--warning);
  color: white;
}

.event-btn-warning:hover {
  background: #d97706;
  transform: translateY(-2px);
  color: white;
}

.event-btn-news {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.event-btn-news:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  color: white;
}

/* Cancelled Event Styling */
.event-card.cancelled {
  opacity: 0.7;
}

.event-card.cancelled .event-card-title {
  text-decoration: line-through;
  color: var(--danger);
}

.event-card.cancelled .event-info-item {
  text-decoration: line-through;
  color: var(--text-light);
}

.event-card.cancelled-corona {
  border: 2px solid var(--success);
  background: rgba(16, 185, 129, 0.05);
}

.corona-icon {
  position: absolute;
  right: 0.5rem;
  top: 0.5rem;
  width: 2rem;
  z-index: 3;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 4rem 2rem;
  animation: fadeIn 0.6s ease-out;
}

.empty-state-icon {
  font-size: 4rem;
  color: var(--text-light);
  margin-bottom: 1rem;
}

.empty-state-title {
  font-family: 'Sora', sans-serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
}

.empty-state-text {
  color: var(--text-secondary);
  font-size: 1.1rem;
}

/* v-cloak: hide Vue template syntax until mounted */
[v-cloak] { display: none !important; }

/* Skeleton Loader */
.skeleton-loader .events-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-top: 1.5rem;
}
@media (max-width: 992px) {
  .skeleton-loader .events-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .skeleton-loader .events-grid { grid-template-columns: 1fr; }
}
.skeleton-card {
  background: var(--card-bg, #fff);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 15px rgba(0,0,0,0.08);
}
.skeleton-card-image {
  height: 180px;
}
.skeleton-card-body {
  padding: 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}
.skeleton-line {
  height: 14px;
  border-radius: 6px;
}
.skeleton-line.title {
  height: 20px;
  width: 75%;
}
.skeleton-line.short {
  width: 55%;
}
.skeleton-line.btn {
  height: 34px;
  width: 45%;
  margin-top: 0.5rem;
  border-radius: 20px;
}

/* Loading State */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: loading 1.5s ease-in-out infinite;
  border-radius: 8px;
}

/* Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

@keyframes loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* Responsive */
@media (max-width: 1400px) {
  .ad-skyscraper {
    display: none;
  }
}

@media (max-width: 768px) {
  .hero-title {
    font-size: 2.5rem;
  }
  
  .events-grid {
    grid-template-columns: 1fr;
  }
  
  .filter-pills {
    justify-content: center;
  }
  
  .ad-banner-top {
    min-height: 80px;
    padding: 1rem;
    font-size: 0.9rem;
  }
}

/* CO2 Badge */
.co2-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--success);
  font-weight: 600;
  font-size: 0.9rem;
}

/* Stagger animations for event cards */
.event-card:nth-child(1) { animation-delay: 0.1s; }
.event-card:nth-child(2) { animation-delay: 0.15s; }
.event-card:nth-child(3) { animation-delay: 0.2s; }
.event-card:nth-child(4) { animation-delay: 0.25s; }
.event-card:nth-child(5) { animation-delay: 0.3s; }
.event-card:nth-child(6) { animation-delay: 0.35s; }
.event-card:nth-child(7) { animation-delay: 0.4s; }
.event-card:nth-child(8) { animation-delay: 0.45s; }
.event-card:nth-child(9) { animation-delay: 0.5s; }

/* Smooth scroll */
html {
  scroll-behavior: smooth;
}

/* Filter row (search + year select) */
.filter-row {
  display: flex;
  gap: 0.75rem;
  align-items: stretch;
  margin-top: 1rem;
  flex-wrap: wrap;
}

.filter-row .search-box {
  flex: 1 1 240px;
  margin-top: 0;
}

.year-select {
  flex: 0 0 auto;
  padding: 0.875rem 1.25rem;
  border: 2px solid var(--border);
  border-radius: 12px;
  font-size: 1rem;
  font-family: 'Sora', sans-serif;
  font-weight: 600;
  background: var(--bg-primary);
  color: var(--text-primary);
  cursor: pointer;
  transition: all 0.3s ease;
}

.year-select:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(0, 137, 123, 0.15);
}
</style>
