    // Load events from PHP
    this.events = this.processEvents([{"0":"438","id":"438","1":"Bavarian Open 2026","name":"Bavarian Open 2026","2":"2","festival_id":"2","3":"233","wsdc_event_id":"233","4":"1","event_type":"1","5":"5","calculation_model":"5","6":null,"slug":null,"7":"wsdc","dances":"wsdc","8":"1","is_wsdc":"1","9":"0","is_taf":"0","10":"0","is_bzdc":"0","11":"0","is_bachatacouncil":"0","12":"0","is_country":"0","13":"4496b35be74e3099195c8ef49ffc17e5","img_header_md5":"4496b35be74e3099195c8ef49ffc17e5","14":null,"facebook_event_id":null,"15":"2026-09-10 00:00:00","dt_event_from":"2026-09-10 00:00:00","16":"2026-09-14 23:59:00","dt_event_to":"2026-09-14 23:59:00","17":"München","city":"München","18":"1726","city_wikidata_id":"1726","19":"DEU","country":"DEU","20":"Europe\/Berlin","timezone":"Europe\/Berlin","21":"EUR","currency":"EUR","22":"","currency2":"","23":"","paypal_email":"","24":"0.000","paypal_fee_percent":"0.000","25":null,"stripe_api_private":null,"26":null,"stripe_connect_account_id":null,"27":"customer","stripe_connect_whotakesfees":"customer","28":"0","goo1_paypal_enabled":"0","29":null,"num_couples_floor":null,"30":"https:\/\/bavarianopen.com\/registration","url_ticket":"https:\/\/bavarianopen.com\/registration","31":null,"steprightsolution_sync_url":null,"32":null,"steprightsolution_sync_sleep":null,"33":null,"is_judge_hide_times":null,"34":"1","is_mockjudge_shownfront":"1","35":"0","allow_mockjudge_facebook":"0","36":"1","allow_mockjudge_patreon":"1","37":"1","allow_mockjudging_by_ed":"1","38":"1","allow_mockjudging_by_hj":"1","39":"0","is_mockjudge_free":"0","40":"1","bib2go_enabled":"1","41":null,"bib2go_resbib_start":null,"42":null,"bib2go_resbib_end":null,"43":"{\u0022wsdc\u0022:{\u0022fee\u0022:{\u0022paymethod\u0022:\u0022self\u0022,\u0022cc\u0022:{\u0022month\u0022:\u002201\u0022,\u0022year\u0022:\u00222026\u0022,\u0022type\u0022:\u0022\u0022,\u0022owner\u0022:\u0022\u0022},\u0022dd\u0022:{\u0022owner\u0022:\u0022\u0022,\u0022iban\u0022:\u0022\u0022,\u0022b