#dks-consent{position:fixed;left:0;right:0;bottom:0;z-index:2147483000;background:#1b1b1b;color:#f2f2f2;
  box-shadow:0 -0.5rem 1.5rem rgba(0,0,0,.4);font-size:.9rem;line-height:1.4;padding:1rem 1rem calc(1rem + env(safe-area-inset-bottom))}
#dks-consent[hidden]{display:none}
#dks-consent .dks-wrap{max-width:1100px;margin:0 auto;display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between}
#dks-consent h2{font-size:1rem;margin:0 0 .25rem}
#dks-consent a{color:#8ec5ff;text-decoration:underline}
#dks-consent .dks-opts{display:flex;flex-wrap:wrap;gap:.75rem 1.25rem;margin:.5rem 0}
#dks-consent .dks-opts label{display:inline-flex;align-items:center;gap:.4rem;margin:0;font-weight:400}
#dks-consent .dks-btns{display:flex;flex-wrap:wrap;gap:.5rem}
#dks-consent button{border:0;border-radius:.35rem;padding:.5rem 1rem;font-size:.9rem;cursor:pointer;font-weight:600}
#dks-consent .dks-accept{background:#2e7d32;color:#fff}
#dks-consent .dks-save{background:#495057;color:#fff}
#dks-consent .dks-reject{background:transparent;color:#ddd;text-decoration:underline;font-weight:400}
</style>

<div id="dks-consent" role="dialog" aria-live="polite" aria-label="Privacy settings" hidden>
  <div class="dks-wrap">
    <div style="flex:1 1 340px;min-width:280px">
      <h2>We value your privacy</h2>
      <div>We use cookies and similar technologies. Necessary ones are required for the site to work. Optional ones (statistics, marketing) are only used with your consent.        <a href="/datenschutz" target="_blank" rel="nofollow">data privacy</a> ·
        <a href="/impressum" target="_blank" rel="nofollow">Imprint</a></div>
      <div class="dks-opts">
        <label><input type="checkbox" checked disabled> Necessary</label>
        <label><input type="checkbox" id="dks-cb-statistics"> Statistics</label>
        <label><input type="checkbox" id="dks-cb-marketing"> Marketing</label>
      </div>
    </div>
    <div class="dks-btns">
      <button type="button" class="dks-accept" id="dks-accept">Accept all</button>
      <button type="button" class="dks-save" id="dks-save">Save selection</button>
      <button type="button" class="dks-reject" id="dks-reject">Necessary only</button>
    </div>
  </div>
</div>

<script>
(function(){
  var KEY = "dks_consent";
  var CATS = ["statistics","marketing"];
  var queue = { statistics: [], marketing: [] };

  function readCookie(){
    try {
      var m = document.cookie.match(/(?:^|;\s*)dks_consent=([^;]+)/);
      if (!m) return null;
      return JSON.parse(decodeURIComponent(m[1]));
    } catch(e){ return null; }
  }
  function writeCookie(state){
    var val = encodeURIComponent(JSON.stringify(state));
    var secure = (location.protocol === "https:") ? "; Secure" : "";
    document.cookie = KEY + "=" + val + "; path=/; max-age=" + (60*60*24*180) + "; SameSite=Lax" + secure;
  }

  var state = readCookie();

  function flush(){
    CATS.forEach(function(c){
      if (state && state[c]) {
        (queue[c] || []).forEach(function(fn){ try { fn(); } catch(e){} });
        queue[c] = [];
      }
    });
  }
  function banner(){ return document.getElementById("dks-consent"); }
  function show(){ var b = banner(); if (b) b.hidden = false; }
  function hide(){ var b = banner(); if (b) b.hidden = true; }

  function persist(stat, mark){
    state = { v: 1, necessary: true, statistics: !!stat, marketing: !!mark, ts: Math.floor(Date.now()/1000) };
    writeCookie(state);
    hide();
    flush();
  }

  window.dksConsent = {
    get: function(cat){ return !!(state && state[cat]); },
    // Führt fn sofort aus, wenn die Kategorie erlaubt ist, sonst sobald eingewilligt wird.
    onGrant: function(cat, fn){
      if (this.get(cat)) { try { fn(); } catch(e){} }
      else if (queue[cat]) queue[cat].push(fn);
    },
    open: function(){
      var s = document.getElementById("dks-cb-statistics"), m = document.getElementById("dks-cb-marketing");
      if (s) s.checked = !!(state && state.statistics);
      if (m) m.checked = !!(state && state.marketing);
      show();
    }
  };

  document.addEventListener("DOMContentLoaded", function(){
    var accept = document.getElementById("dks-accept");
    var save   = document.getElementById("dks-save");
    var reject = document.getElementById("dks-reject");
    if (accept) accept.addEventListener("click", function(){ persist(true, true); });
    if (reject) reject.addEventListener("click", function(){ persist(false, false); });
    if (save)   save.addEventListener("click", function(){
      persist(
        !!(document.getElementById("dks-cb-statistics") || {}).checked,
        !!(document.getElementById("dks-cb-marketing") || {}).checked
      );
    });
    // Beim ersten Besuch (noch keine Entscheidung) Banner zeigen.
    if (!state) show();
  });
})();
</script>

